{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/no-inline-blobs.sh",
            "statusMessage": "checking for inline script blobs"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/troubleshooting.sh",
            "timeout": 20,
            "statusMessage": "checking recipe status and failure history"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/git-stamp.sh",
            "timeout": 20,
            "statusMessage": "stamping a commit with its agent"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/settings-guard.sh",
            "timeout": 20,
            "statusMessage": "checking for a write to settings.json"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/primary-guard.sh",
            "timeout": 20,
            "statusMessage": "checking for a live writer of the target"
          }
        ]
      },
      {
        "matcher": "WebFetch|mcp__claude-in-chrome__(navigate|tabs_create_mcp)",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/prefer-recipes.sh",
            "timeout": 20,
            "statusMessage": "checking for an existing recipe"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/settings-guard.sh",
            "timeout": 20,
            "statusMessage": "checking for a write to settings.json"
          }
        ]
      },
      {
        "matcher": "mcp__.*([Gg]mail|[Dd]rive|[Dd]ropbox).*",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ask-first.sh",
            "timeout": 20,
            "statusMessage": "checking for a send on the user's behalf"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/no-secrets.sh",
            "timeout": 20,
            "statusMessage": "checking for a credential-shaped value"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/primary-guard.sh",
            "timeout": 20,
            "statusMessage": "checking for a live writer of the target"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/write-ledger.sh",
            "timeout": 20,
            "statusMessage": "recording the write"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/push-gate.sh",
            "timeout": 30,
            "statusMessage": "checking for unpushed work"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/push-gate.sh",
            "timeout": 30,
            "statusMessage": "checking for unpushed work"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/write-ledger.sh",
            "timeout": 20,
            "statusMessage": "recording the stop"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/write-ledger.sh",
            "timeout": 20,
            "statusMessage": "recording the session end"
          }
        ]
      }
    ]
  }
}
